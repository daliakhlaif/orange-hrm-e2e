  "devDependencies": {
    "@mmisty/cypress-allure-adapter": "^3.3.0",
    "@types/node": "^24.6.2",
    "allure-commandline": "^2.34.1",
    "cypress": "^15.3.0",
    "cypress-file-upload": "^5.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
