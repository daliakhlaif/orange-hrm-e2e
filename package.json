{
  "name": "orange-hrm-e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:allure": "rm -rf allure-results allure-report",
    "test:login": "npm run clean:allure && cypress run --spec 'cypress/e2e/login/login-spec.cy.ts'",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:login": "npm run test:login && npm run report:generate",
    "test": "npm run clean:allure && npm run test:login && npm run report:generate",
    "ci:clean": "rm -rf allure-results allure-report",
    "ci:test:all": "npm run ci:clean && cypress run",
    "ci:test:login": "npm run ci:clean && cypress run --spec 'cypress/e2e/login/login-spec.cy.ts'"
  },
  "keywords": [],
